# Required: gates the dashboard and the MCP endpoint. Generate one:
#   openssl rand -hex 24
FEIN_AUTH_TOKEN=

# Where docker publishes the port. Default binds loopback only (pair it with
# a reverse proxy on the same host). Use 0.0.0.0:4321 to expose directly.
FEIN_PUBLISH=127.0.0.1:4321

# Optional: enables LLM mention extraction over document bodies.
#ANTHROPIC_API_KEY=

# Optional: password for the bundled Postgres (--profile postgres).
#POSTGRES_PASSWORD=
